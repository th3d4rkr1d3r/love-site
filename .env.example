# Copie para .env (nunca commitar valores reais).
# Na Vercel: Project Settings → Environment Variables
# (Production / Preview / Development separados).

# --- App / Auth.js (Credentials no V3) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PostgreSQL ---
# Local (docker compose): as duas URLs podem ser iguais.
# Produção (Vercel Postgres / Neon):
#   DATABASE_URL  = connection pooled (pgbouncer) — runtime serverless
#   DIRECT_URL    = conexão direta — prisma migrate deploy
# Local (docker compose): a 5432 desta máquina já está ocupada.
# Se `localhost` falhar com P1000, use 127.0.0.2 (outro processo intercepta 127.0.0.1).
DATABASE_URL="postgresql://love:love@localhost:5433/lovesite?schema=public"
DIRECT_URL="postgresql://love:love@localhost:5433/lovesite?schema=public"

# --- Storage ---
# V0/V1: local (public/uploads). V3: r2 com URL pré-assinada.
STORAGE_PROVIDER=local

# Cloudflare R2 (V3) — upload direto do browser (CORS PUT/POST no bucket,
# origin = domínio de produção). Não passar arquivos grandes pelas API routes
# da Vercel (~4,5 MB).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Hostname público do bucket, sem protocolo. Ex: pub-xxxx.r2.dev ou cdn.seudominio.com
R2_PUBLIC_HOST=

# --- Mapbox (V2) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
